// AquaSpain Worker configuration
// Serves the Vite build (dist/) as static assets and the reservoir dataset from KV.
{
  "account_id": "93884eec2b1e8670c2a05c30d7802bdf",
  "name": "aquaspain",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The dataset and API routes must be handled by the Worker, not by static assets
    "run_worker_first": ["/datos_embalses_optimizado.json", "/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "DATOS_KV",
      "id": "0d5d6f48f1e3437dbde92cd5ade00257"
    }
  ],
  // Tuesday–Thursday freshness check, after the 15:00 UTC ETL window
  "triggers": {
    "crons": ["0 16 * * 2-4"]
  },
  "observability": {
    "enabled": true
  }
}
